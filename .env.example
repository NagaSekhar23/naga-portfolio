# ───── Public site ─────
# Canonical URL (used for SEO, sitemap, Open Graph). Set in Vercel once you have a domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ───── Sanity CMS ─────
# Project ID and dataset are public identifiers (safe in the browser). Get them from
# https://www.sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# ───── Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ─────
# Viewer token — lets the server fetch unpublished drafts for preview.
SANITY_API_READ_TOKEN=
# Webhook signing secret — only Sanity can trigger revalidation. Use a long random string.
SANITY_REVALIDATE_SECRET=
# Editor token — used ONLY by `npm run cms:seed` on your computer. Do not add to Vercel.
SANITY_API_WRITE_TOKEN=
